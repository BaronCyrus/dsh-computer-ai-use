{
  "name": "dsh-computer-ai-use",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "description": "Computer use for DeepSeek Harness on macOS and Windows, built on the UI-TARS desktop operator",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "ui-tars",
    "desktop-automation"
  ],
  "author": "BaronCyrus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaronCyrus/dsh-computer-ai-use.git"
  },
  "bugs": {
    "url": "https://github.com/BaronCyrus/dsh-computer-ai-use/issues"
  },
  "homepage": "https://github.com/BaronCyrus/dsh-computer-ai-use#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@computer-use/nut-js": "4.2.0",
    "@ui-tars/operator-nut-js": "1.2.3",
    "@ui-tars/sdk": "1.2.3",
    "jimp": "1.6.0"
  },
  "optionalDependencies": {
    "@computer-use/node-mac-permissions": "2.2.2"
  }
}
