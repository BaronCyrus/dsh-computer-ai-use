{
  "name": "dsh-computer-ai-use",
  "version": "0.2.0",
  "packageManager": "pnpm@10.32.1",
  "description": "Computer use for DeepSeek Harness on macOS and Windows, built on the UI-TARS desktop operator",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.png",
    "lib/*.js",
    "locale/*.json",
    "scripts/smoke.mjs",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "compatibility.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && node scripts/install-check.mjs && pnpm pack --pack-destination .artifacts"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "ui-tars",
    "desktop-automation"
  ],
  "author": "BaronCyrus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaronCyrus/dsh-computer-ai-use.git"
  },
  "bugs": {
    "url": "https://github.com/BaronCyrus/dsh-computer-ai-use/issues"
  },
  "homepage": "https://github.com/BaronCyrus/dsh-computer-ai-use#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@computer-use/nut-js": "4.2.0",
    "@ui-tars/operator-nut-js": "1.2.3",
    "@ui-tars/sdk": "1.2.3",
    "jimp": "1.6.0",
    "semver": "7.8.5"
  },
  "optionalDependencies": {
    "@computer-use/node-mac-permissions": "2.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5",
    "pnpm": "11.28.5",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
